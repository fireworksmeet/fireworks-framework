            </dependency>
            <dependency>
                <groupId>org.bytedeco</groupId>
                <artifactId>ffmpeg</artifactId>
                <version>${ffmpeg.version}</version>
            </dependency>
            <!--
                CosId 分布式 ID：直接导入其 BOM 统一管理（该工程有 20+ artifact，逐个管版本容易错配）。
                版本线约定（务必对齐 Spring Boot 大版本）：
                  1.x → Spring Boot 2.x / Java 8
                  2.x → Spring Boot 3.x / Java 17  ← 本项目使用
                  3.x → Spring Boot 4.x
            -->
            <dependency>
                <groupId>me.ahoo.cosid</groupId>
                <artifactId>cosid-bom</artifactId>
                <version>${cosid.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
