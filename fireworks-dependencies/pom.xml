        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <rocketmq-spring-boot-starter.version>2.3.5</rocketmq-spring-boot-starter.version>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <janino.version>3.1.12</janino.version>
        <!-- 访问日志。固定在 Boot 3 世代线，不跟随 4.x（4.x 主线面向 Spring Boot 4） -->
        <logbook.version>3.12.3</logbook.version>
        <springdoc-openapi.version>2.8.14</springdoc-openapi.version>
        <swagger-annotations.version>2.2.41</swagger-annotations.version>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <xxl-job-core.version>3.3.1</xxl-job-core.version>
