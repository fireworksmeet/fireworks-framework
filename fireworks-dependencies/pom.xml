        <modelmapper-spring-boot-starter.version>1.1.0</modelmapper-spring-boot-starter.version>
        <modelmapper.version>3.1.1</modelmapper.version>
        <aliyun-java-sdk-dysmsapi.version>4.4.0</aliyun-java-sdk-dysmsapi.version>
        <redisson.version>3.52.0</redisson.version>
        <aws-sdk.version>2.55.7</aws-sdk.version>
        <tika.version>3.2.1</tika.version>
        <ffmpeg.version>6.0-1.5.9</ffmpeg.version>
        <cosid.version>2.15.2</cosid.version>
        <tencentcloud-sdk-java-sms.version>3.1.1357</tencentcloud-sdk-java-sms.version>
        <yauaa.version>8.1.0</yauaa.version>
        <ip2region.version>3.3.4</ip2region.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <aj-captcha.version>1.4.0</aj-captcha.version>
        <!-- 固定在 Boot 3 世代线：2.x 面向 Spring Boot 4，会传递 spring-boot-jdbc:4.x 导致自动配置类重名 -->
        <p6spy-spring-boot-starter.version>1.12.1</p6spy-spring-boot-starter.version>
        <latencyutils.version>2.0.3</latencyutils.version>
        <powerjob.version>5.1.2</powerjob.version>
        <jetbrains.annotations.version>26.1.0</jetbrains.annotations.version>
        <!-- bcprov / bcpkix 必须同版本：bcpkix 依赖 bcprov 的内部 ASN.1 API -->
        <bouncycastle.version>1.84</bouncycastle.version>
    </properties>

